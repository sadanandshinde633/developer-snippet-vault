# ========================================================
# DEVELOPER SNIPPET VAULT & AI PUBLISHER - ENVIRONMENT VARIABLES
# ========================================================

# 1. MongoDB Atlas Database Connection URI (Required)
# Set in Vercel Project Settings > Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# 2. JWT Session Secret (Required)
# Minimum 32 characters random string for signing HTTP-only cookies
JWT_SECRET=your-random-32-character-jwt-secret-key

# 3. Google Gemini API Key (Required for AI Auto-Tagging & Summaries)
# Generate from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# 4. Canonical App URL (Optional)
# In production on Vercel, this is auto-detected from VERCEL_URL if omitted.
# Set if you use a custom domain.
APP_URL=https://your-domain.vercel.app

# 5. GitHub OAuth 2.0 Credentials (Optional)
# Callback URL in GitHub Developer Settings:
# Development: http://localhost:3000/api/auth/oauth/github/callback
# Production:  https://your-domain.vercel.app/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 6. Google OAuth 2.0 Credentials (Optional)
# Authorized Redirect URI in Google Cloud Console:
# Development: http://localhost:3000/api/auth/oauth/google/callback
# Production:  https://your-domain.vercel.app/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
