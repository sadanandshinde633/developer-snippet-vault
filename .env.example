# MongoDB Atlas Database Connection String
# Replace <db_password> with your actual database user password
MONGODB_URI=mongodb+srv://smshinde2005:<db_password>@1.apbgvnp.mongodb.net/?appName=1

# JWT Secret for User Authentication Sessions
JWT_SECRET=generate-a-strong-random-secret-key-here-32-chars-minimum

# Google Gemini API Key (@google/genai)
# Obtain for free at: https://aistudio.google.com/app/apikey
